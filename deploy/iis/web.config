<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS configuration for EnterpriseViz.

  HttpPlatformHandler starts waitress on a loopback port it picks
  (%HTTP_PLATFORM_PORT%), owns that process's lifetime, and reverse proxies to
  it. waitress is pure Python and gets its concurrency from a thread pool, so
  it runs on Windows unchanged and is the same WSGI server used in the
  container images.

  Copy this to the site root (the backend directory) and replace the three D:\
  paths below.

  Prerequisite: HttpPlatformHandler 1.2 (a Microsoft-signed IIS extension).
-->
<configuration>
  <system.webServer>

    <handlers>
      <!-- Hand every request to the Python process. -->
      <add name="httpPlatformHandler"
           path="*"
           verb="*"
           modules="httpPlatformHandler"
           resourceType="Unspecified"
           requireAccess="Script" />
    </handlers>

    <!--
      startupTimeLimit is deliberately large: the first request imports the
      arcgis package, which pulls in numpy and pandas and takes 5-20 seconds on
      a cold process. The default 20s produces a 502 on the first hit after
      every recycle.

      channel-timeout must exceed the slowest synchronous view; waitress
      defaults to 120s, which some portal-backed pages exceed.

      processesPerApplication is 1 on purpose. Concurrency comes from waitress
      threads, and a second process would double the database connections for
      no benefit — background work does not run here, it runs in the worker.
    -->
    <httpPlatform processPath="D:\apps\enterpriseviz\.venv\Scripts\python.exe"
                  arguments="-m waitress --listen=127.0.0.1:%HTTP_PLATFORM_PORT% --threads=16 --channel-timeout=1200 config.wsgi:application"
                  stdoutLogEnabled="true"
                  stdoutLogFile="D:\logs\enterpriseviz\stdout"
                  startupTimeLimit="120"
                  startupRetryCount="3"
                  requestTimeout="00:20:00"
                  processesPerApplication="1">
      <environmentVariables>
        <environmentVariable name="DJANGO_SETTINGS_MODULE" value="config.settings.production" />
        <!-- Secrets live in a .env file ACLed to the service account rather
             than in this file, which IIS management tooling displays.
             settings/base.py reads .env by default, from one level above
             BASE_DIR (outside the site directory) and nowhere else; this
             variable is stated explicitly so the intent is visible here. -->
        <environmentVariable name="DJANGO_READ_DOT_ENV_FILE" value="True" />
        <environmentVariable name="PYTHONPATH" value="D:\apps\enterpriseviz\backend" />
        <environmentVariable name="PYTHONUNBUFFERED" value="1" />
      </environmentVariables>
    </httpPlatform>

    <security>
      <requestFiltering>
        <!-- Portal refreshes post large forms; the IIS default is 30MB, which
             is fine, but the request limit below matches waitress. -->
        <requestLimits maxAllowedContentLength="52428800" />

        <fileExtensions>
          <add fileExtension=".env" allowed="false" />
          <add fileExtension=".ini" allowed="false" />
          <add fileExtension=".sqlite3" allowed="false" />
          <add fileExtension=".log" allowed="false" />
        </fileExtensions>
        <hiddenSegments>
          <add segment=".venv" />
          <add segment=".git" />
          <add segment="__pycache__" />
          <add segment="requirements" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
